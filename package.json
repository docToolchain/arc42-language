{
  "name": "arc42-language",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "test": "vp test",
    "check": "vp check",
    "ready": "pnpm run check && pnpm run test && pnpm run build",
    "validate:docs": "node packages/cli/dist/cli.mjs --dir docs/arc42 validate",
    "validate:examples": "node packages/cli/dist/cli.mjs --dir examples/bookstore-backend validate",
    "validate:all": "pnpm run validate:docs && pnpm run validate:examples",
    "validate:source": "node --experimental-strip-types --no-warnings scripts/validate-source.ts",
    "hooks:install": "vp config && echo 'git hooks installed via vp config (core.hooksPath=.vite-hooks/_)'",
    "version:patch": "pnpm --filter @doctc/arc42 exec npm version patch --no-git-tag-version",
    "version:minor": "pnpm --filter @doctc/arc42 exec npm version minor --no-git-tag-version",
    "version:major": "pnpm --filter @doctc/arc42 exec npm version major --no-git-tag-version",
    "release": "pnpm publish -r --access public"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.6"
  },
  "packageManager": "pnpm@10.32.1"
}
