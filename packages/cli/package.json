{
  "name": "@doctc/arc42",
  "version": "0.0.10",
  "description": "CLI for validating and querying arc42 DSL files.",
  "keywords": [
    "arc42",
    "architecture",
    "cli",
    "documentation",
    "dsl",
    "validation"
  ],
  "homepage": "https://github.com/docToolchain/arc42-language",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/docToolchain/arc42-language.git",
    "directory": "packages/cli"
  },
  "bin": {
    "arc42": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build:web": "pnpm --filter @arc42/web build",
    "build": "pnpm build:web && vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:e2e": "pnpm --filter @arc42/web test:e2e",
    "check": "vp check",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "release": "pnpm publish --access public"
  },
  "devDependencies": {
    "@arc42/core": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
