{
  "name": "@doctc/arc42",
  "version": "0.0.10",
  "description": "CLI for validating and querying arc42 DSL files.",
  "keywords": [
    "arc42",
    "architecture",
    "cli",
    "documentation",
    "dsl",
    "validation"
  ],
  "homepage": "https://github.com/docToolchain/arc42-language",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/docToolchain/arc42-language.git",
    "directory": "packages/cli"
  },
  "bin": {
    "arc42": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build:web": "pnpm --filter @arc42/web build",
    "check:templates": "node --conditions=development --experimental-strip-types --no-warnings ../../scripts/check-starter-templates.ts",
    "prebuild": "pnpm run check:templates && pnpm --filter @arc42/workspace-fs build",
    "build": "pnpm build:web && vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:e2e": "pnpm --filter @arc42/web test:e2e",
    "check": "pnpm run check:templates && vp check",
    "prepack": "pnpm run check:templates",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "release": "pnpm publish --access public"
  },
  "dependencies": {
    "mermaid": "11.17.2"
  },
  "devDependencies": {
    "@arc42/core": "workspace:*",
    "@arc42/workspace-fs": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
