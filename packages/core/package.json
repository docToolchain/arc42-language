{
  "name": "@arc42/core",
  "version": "0.1.1",
  "private": true,
  "description": "Core validation engine for arc42 DSL files.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./types": {
      "types": "./src/types-export.ts",
      "development": "./src/types-export.ts",
      "default": "./dist/types-export.mjs"
    },
    "./parser": {
      "types": "./src/parser/index.ts",
      "development": "./src/parser/index.ts",
      "default": "./dist/parser/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@arc42/mermaid": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
